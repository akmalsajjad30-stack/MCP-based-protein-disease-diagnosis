# MediRAG v3 — Environment Variables
# Copy this file to .env and fill in your values

# === REQUIRED ===
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# === NEO4J (free Neo4j Desktop) ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medirag2024

# === NCBI / PubMed (free, optional key for higher rate limits) ===
# Get free key at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# === OMIM (free key required) ===
# Register at: https://omim.org/api
OMIM_API_KEY=

# === FDA (optional, increases rate limits) ===
FDA_API_KEY=

# === APP SETTINGS ===
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === CHROMADB ===
CHROMA_PERSIST_DIR=./chroma_data
